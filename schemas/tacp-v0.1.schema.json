{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TACP v0.1.0 Closed Mission Bundle",
  "description": "Structural validation for specs/tacp-v0.1.md. This schema validates closed mission bundles, not live partial streams or runtime safety.",
  "$comment": "Use a strict JSON parser: reject duplicate object keys and non-finite numbers before schema validation. Enable date-time format assertion. Separate semantic validation MUST check closure-last ordering, unique IDs, same-mission identity, reference resolution/type/order, sequential revisions/rounds, review evidence classification, latest-assessment bindings, action equality, timestamps/freshness, budgets, condition-ID coverage, state transitions, and closure consistency. Runtime validation MUST enforce authenticity, permissions, revocation, resource metering, operation reservations, and conditional dispatch. Schema acceptance is not execution authorization or a safety certification.",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": "0.1.0"
    },
    "mission_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      },
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/mission"
        }
      ],
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "record_type": {
                "const": "mission"
              }
            },
            "required": [
              "record_type"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "record_type": {
                "const": "closure"
              }
            },
            "required": [
              "record_type"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "record_type": {
                "const": "execution"
              }
            },
            "required": [
              "record_type"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "if": {
            "contains": {
              "type": "object",
              "properties": {
                "record_type": {
                  "const": "verification"
                }
              },
              "required": [
                "record_type"
              ]
            }
          },
          "then": {
            "contains": {
              "type": "object",
              "properties": {
                "record_type": {
                  "const": "closure"
                }
              },
              "required": [
                "record_type",
                "verification_ref"
              ]
            }
          },
          "else": {
            "contains": {
              "type": "object",
              "properties": {
                "record_type": {
                  "const": "closure"
                }
              },
              "required": [
                "record_type"
              ],
              "not": {
                "required": [
                  "verification_ref"
                ]
              }
            }
          }
        },
        {
          "if": {
            "contains": {
              "type": "object",
              "properties": {
                "record_type": {
                  "const": "closure"
                },
                "execution_status": {
                  "const": "recorded"
                }
              },
              "required": [
                "record_type",
                "execution_status"
              ]
            }
          },
          "then": {
            "contains": {
              "type": "object",
              "properties": {
                "record_type": {
                  "const": "execution"
                }
              },
              "required": [
                "record_type"
              ]
            }
          }
        },
        {
          "if": {
            "contains": {
              "type": "object",
              "properties": {
                "record_type": {
                  "const": "closure"
                },
                "execution_status": {
                  "const": "not_dispatched"
                }
              },
              "required": [
                "record_type",
                "execution_status"
              ]
            }
          },
          "then": {
            "not": {
              "contains": {
                "type": "object",
                "properties": {
                  "record_type": {
                    "const": "execution"
                  }
                },
                "required": [
                  "record_type"
                ]
              }
            }
          }
        },
        {
          "if": {
            "contains": {
              "type": "object",
              "properties": {
                "record_type": {
                  "const": "closure"
                },
                "disposition": {
                  "const": "completed"
                }
              },
              "required": [
                "record_type",
                "disposition"
              ]
            }
          },
          "then": {
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "record_type": {
                      "const": "verification"
                    },
                    "decision": {
                      "const": "completed"
                    }
                  },
                  "required": [
                    "record_type",
                    "decision"
                  ]
                }
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "record_type": {
                      "const": "execution"
                    },
                    "outcome": {
                      "const": "succeeded"
                    }
                  },
                  "required": [
                    "record_type",
                    "outcome"
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "protocol_version",
    "mission_id",
    "records"
  ],
  "additionalProperties": false,
  "$defs": {
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque record or deployment reference. Resolution, type, order, and authenticity require separate validation."
    },
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
      "$comment": "Enable date-time format assertion. The pattern enforces UTC syntax; format checking must reject invalid calendar dates. Relative time ordering is semantic validation."
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "nonempty_references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "check_result": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "unknown"
      ]
    },
    "action": {
      "type": "object",
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "target_ref": {
          "$ref": "#/$defs/reference"
        },
        "operation": {
          "$ref": "#/$defs/nonempty_string"
        },
        "parameters": {
          "type": "object"
        }
      },
      "required": [
        "operation_id",
        "target_ref",
        "operation",
        "parameters"
      ],
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "properties": {
        "condition_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "description": {
          "$ref": "#/$defs/nonempty_string"
        }
      },
      "required": [
        "condition_id",
        "description"
      ],
      "additionalProperties": false
    },
    "resource_budget": {
      "type": "object",
      "properties": {
        "budget_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "unit": {
          "$ref": "#/$defs/nonempty_string"
        },
        "limit": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "budget_id",
        "unit",
        "limit"
      ],
      "additionalProperties": false
    },
    "gate_resource_usage": {
      "type": "object",
      "properties": {
        "budget_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "used": {
          "type": "number",
          "minimum": 0
        },
        "reserved": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "budget_id",
        "used",
        "reserved"
      ],
      "additionalProperties": false
    },
    "closure_resource_usage": {
      "type": "object",
      "properties": {
        "budget_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "used": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "budget_id",
        "used"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/reference"
        },
        "retrieved_at": {
          "$ref": "#/$defs/utc_timestamp"
        }
      },
      "required": [
        "source_ref",
        "retrieved_at"
      ],
      "additionalProperties": false
    },
    "target_state": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/nonempty_string"
        },
        "value": {
          "$ref": "#/$defs/nonempty_string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "unknown"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "const": "unknown"
              }
            }
          }
        }
      ]
    },
    "prerequisite": {
      "type": "object",
      "properties": {
        "prerequisite_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "description": {
          "$ref": "#/$defs/nonempty_string"
        },
        "check_ref": {
          "$ref": "#/$defs/reference"
        }
      },
      "required": [
        "prerequisite_id",
        "description",
        "check_ref"
      ],
      "additionalProperties": false
    },
    "open_issue": {
      "type": "object",
      "properties": {
        "issue_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "description": {
          "$ref": "#/$defs/nonempty_string"
        },
        "blocks_execution": {
          "type": "boolean"
        }
      },
      "required": [
        "issue_id",
        "description",
        "blocks_execution"
      ],
      "additionalProperties": false
    },
    "review_check": {
      "type": "object",
      "properties": {
        "question": {
          "$ref": "#/$defs/nonempty_string"
        },
        "method": {
          "$ref": "#/$defs/nonempty_string"
        },
        "finding": {
          "$ref": "#/$defs/nonempty_string"
        },
        "evidence_refs": {
          "$ref": "#/$defs/references"
        }
      },
      "required": [
        "question",
        "method",
        "finding",
        "evidence_refs"
      ],
      "additionalProperties": false,
      "$comment": "Empty evidence_refs is allowed only when finding explicitly remains unverified. This natural-language requirement needs semantic review."
    },
    "issue_update": {
      "type": "object",
      "properties": {
        "issue_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "resolved"
          ]
        },
        "explanation": {
          "$ref": "#/$defs/nonempty_string"
        },
        "evidence_refs": {
          "$ref": "#/$defs/references"
        }
      },
      "required": [
        "issue_id",
        "status",
        "explanation",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "prerequisite_result": {
      "type": "object",
      "properties": {
        "prerequisite_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "result": {
          "$ref": "#/$defs/check_result"
        },
        "evidence_ref": {
          "$ref": "#/$defs/reference"
        }
      },
      "required": [
        "prerequisite_id",
        "result",
        "evidence_ref"
      ],
      "additionalProperties": false
    },
    "expected_result_check": {
      "type": "object",
      "properties": {
        "condition_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "result": {
          "type": "string",
          "enum": [
            "met",
            "not_met",
            "unknown"
          ]
        },
        "evidence_refs": {
          "$ref": "#/$defs/nonempty_references"
        }
      },
      "required": [
        "condition_id",
        "result",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "stop_condition_check": {
      "type": "object",
      "properties": {
        "condition_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "result": {
          "type": "string",
          "enum": [
            "triggered",
            "clear",
            "unknown"
          ]
        },
        "evidence_refs": {
          "$ref": "#/$defs/nonempty_references"
        }
      },
      "required": [
        "condition_id",
        "result",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "remaining_issue": {
      "type": "object",
      "properties": {
        "description": {
          "$ref": "#/$defs/nonempty_string"
        },
        "blocks_completion": {
          "type": "boolean"
        }
      },
      "required": [
        "description",
        "blocks_completion"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_review_rounds": {
          "type": "integer",
          "minimum": 1
        },
        "deadline_at": {
          "$ref": "#/$defs/utc_timestamp"
        },
        "max_observation_age_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_execution_attempts": {
          "type": "integer",
          "const": 1
        },
        "resource_budgets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource_budget"
          },
          "minItems": 1
        }
      },
      "required": [
        "max_review_rounds",
        "deadline_at",
        "max_observation_age_seconds",
        "max_execution_attempts",
        "resource_budgets"
      ],
      "additionalProperties": false
    },
    "mission": {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": "0.1.0"
        },
        "record_type": {
          "const": "mission"
        },
        "record_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "mission_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "created_at": {
          "$ref": "#/$defs/utc_timestamp"
        },
        "producer_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "producer_role": {
          "const": "controller"
        },
        "extensions": {
          "type": "object",
          "description": "Optional non-overriding extension data."
        },
        "objective": {
          "$ref": "#/$defs/nonempty_string"
        },
        "operation_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "observation_scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "authorization_ref": {
          "$ref": "#/$defs/reference"
        },
        "policy_ref": {
          "$ref": "#/$defs/reference"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "expected_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          },
          "minItems": 1
        },
        "stop_conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          },
          "minItems": 1
        }
      },
      "required": [
        "protocol_version",
        "record_type",
        "record_id",
        "mission_id",
        "created_at",
        "producer_id",
        "producer_role",
        "objective",
        "operation_id",
        "observation_scope",
        "authorization_ref",
        "policy_ref",
        "limits",
        "expected_results",
        "stop_conditions"
      ],
      "additionalProperties": false,
      "title": "TACP mission record"
    },
    "observation": {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": "0.1.0"
        },
        "record_type": {
          "const": "observation"
        },
        "record_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "mission_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "created_at": {
          "$ref": "#/$defs/utc_timestamp"
        },
        "producer_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "producer_role": {
          "const": "scout"
        },
        "extensions": {
          "type": "object",
          "description": "Optional non-overriding extension data."
        },
        "phase": {
          "type": "string",
          "enum": [
            "pre_execution",
            "post_execution"
          ]
        },
        "observed_at": {
          "$ref": "#/$defs/utc_timestamp"
        },
        "target_ref": {
          "$ref": "#/$defs/reference"
        },
        "target_state": {
          "$ref": "#/$defs/target_state"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "execution_ref": {
          "$ref": "#/$defs/reference"
        }
      },
      "required": [
        "protocol_version",
        "record_type",
        "record_id",
        "mission_id",
        "created_at",
        "producer_id",
        "producer_role",
        "phase",
        "observed_at",
        "target_ref",
        "target_state",
        "sources",
        "facts",
        "uncertainties"
      ],
      "additionalProperties": false,
      "title": "TACP observation record",
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": {
                "const": "post_execution"
              }
            },
            "required": [
              "phase"
            ]
          },
          "then": {
            "required": [
              "execution_ref"
            ]
          },
          "else": {
            "not": {
              "required": [
                "execution_ref"
              ]
            }
          }
        }
      ]
    },
    "assessment": {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": "0.1.0"
        },
        "record_type": {
          "const": "assessment"
        },
        "record_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "mission_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "created_at": {
          "$ref": "#/$defs/utc_timestamp"
        },
        "producer_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "producer_role": {
          "const": "analyst"
        },
        "extensions": {
          "type": "object",
          "description": "Optional non-overriding extension data."
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "supersedes_ref": {
          "$ref": "#/$defs/reference"
        },
        "observation_refs": {
          "$ref": "#/$defs/nonempty_references"
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "rationale": {
          "$ref": "#/$defs/nonempty_string"
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/prerequisite"
          },
          "minItems": 1
        },
        "open_issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/open_issue"
          },
          "minItems": 0
        },
        "recommendation": {
          "type": "string",
          "enum": [
            "ready",
            "hold",
            "stop"
          ]
        }
      },
      "required": [
        "protocol_version",
        "record_type",
        "record_id",
        "mission_id",
        "created_at",
        "producer_id",
        "producer_role",
        "revision",
        "observation_refs",
        "action",
        "rationale",
        "prerequisites",
        "open_issues",
        "recommendation"
      ],
      "additionalProperties": false,
      "title": "TACP assessment record",
      "allOf": [
        {
          "if": {
            "properties": {
              "revision": {
                "const": 1
              }
            },
            "required": [
              "revision"
            ]
          },
          "then": {
            "not": {
              "required": [
                "supersedes_ref"
              ]
            }
          },
          "else": {
            "required": [
              "supersedes_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "recommendation": {
                "const": "ready"
              }
            },
            "required": [
              "recommendation"
            ]
          },
          "then": {
            "properties": {
              "open_issues": {
                "items": {
                  "properties": {
                    "blocks_execution": {
                      "const": false
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": "0.1.0"
        },
        "record_type": {
          "const": "review"
        },
        "record_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "mission_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "created_at": {
          "$ref": "#/$defs/utc_timestamp"
        },
        "producer_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "producer_role": {
          "const": "analyst"
        },
        "extensions": {
          "type": "object",
          "description": "Optional non-overriding extension data."
        },
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "assessment_ref": {
          "$ref": "#/$defs/reference"
        },
        "previous_review_ref": {
          "$ref": "#/$defs/reference"
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty_string"
          },
          "minItems": 1
        },
        "checks_performed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/review_check"
          },
          "minItems": 1
        },
        "reused_observation_refs": {
          "$ref": "#/$defs/references"
        },
        "new_observation_refs": {
          "$ref": "#/$defs/references"
        },
        "issue_updates": {
          "type": "array",
          "items": {
